# Copy this file to .env.local (local) or add the same keys in Vercel (production).
# Never commit .env.local. Values marked [secret] must stay on the server.

# ── Required ────────────────────────────────────────────────
# Postgres connection string. Local Docker: see docker-compose.yml.
# Vercel → Project → Storage → Neon adds it automatically. Supabase also works: use its "Transaction pooler" URL (port 6543).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yumyum
# Public address of the site, no trailing slash. Used for links in emails, sitemap, canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# [secret] Long random string (≥ 32 characters). Hashes IPs and signs tokens.
# PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256}))   macOS: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# ── First admin (used once by `pnpm db:seed`) ──────────────
SEED_ADMIN_EMAIL=admin@yumyum.local
# Leave empty to get a random temporary password printed by the seed.
SEED_ADMIN_PASSWORD=

# ── Anti-spam: Cloudflare Turnstile (free) ─────────────────
# dash.cloudflare.com → Turnstile → Add site. Empty = check skipped (local only).
# For local testing you may use Cloudflare's test keys: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# In production, forms are refused when Turnstile is not configured, unless this is 1.
ALLOW_NO_TURNSTILE=

# ── Order notifications ────────────────────────────────────
# Which channels to use, comma-separated: telegram, email
NOTIFY_CHANNELS=telegram,email
# Telegram: create a bot with @BotFather, add it to the shop's group, get the chat id (see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email through Resend (free tier): resend.com → API keys. Domain must be verified to send from it.
RESEND_API_KEY=
EMAIL_FROM=YUM-YUM Donuts <orders@your-domain.am>
ORDER_EMAIL_TO=

# ── Photo uploads from the admin panel (Vercel Blob) ───────
# Vercel → Project → Storage → Create → Blob adds this automatically. Empty locally = .uploads/ folder.
BLOB_READ_WRITE_TOKEN=

# ── Privacy and jobs ───────────────────────────────────────
# Days after which names, phones and addresses are removed from orders.
DATA_RETENTION_DAYS=90
# [secret] Vercel Cron sends this as a Bearer token to /api/cron/retention.
CRON_SECRET=

# ── Limits ─────────────────────────────────────────────────
# Orders allowed per hour from one IP address.
ORDER_RATE_LIMIT_PER_HOUR=8

# ── Optional privacy-friendly analytics (loads only after consent) ──
# Plausible: https://plausible.io/js/script.js + your domain. Umami: your script URL + website id.
NEXT_PUBLIC_ANALYTICS_SCRIPT=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
