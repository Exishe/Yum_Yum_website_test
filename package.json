{
  "name": "yumyum-donuts",
  "version": "1.0.0",
  "private": true,
  "description": "Website, ordering and admin for YUM-YUM Donuts, Yerevan",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node -e \"if(!process.env.DATABASE_URL){console.error('DATABASE_URL is not set. Vercel: Storage → Create Database → Neon, connect it to this project.');process.exit(1)}\" && pnpm db:migrate && pnpm db:seed && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "images": "tsx scripts/prepare-images.ts",
    "prepare": "husky",
    "demo": "tsx scripts/demo.ts && next dev",
    "demo:reset": "tsx db/reset.ts",
    "share": "tsx scripts/share.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@hookform/resolvers": "6.0.0",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
